# Kārya
#
# Rule that outranks everything in this file: real candidate data never enters
# this repository. Not in fixtures, not in tests, not in a phase report, not in
# a screenshot. fixtures/ holds synthetic data only. If you are about to add an
# exception here for "just one real file", stop.

# ---- Secrets and signing material -------------------------------------------
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.key
*.keystore
*.jks
*.mobileprovision
*.provisionprofile
secrets/
**/local.properties

# ---- Real data, backups, and local state ------------------------------------
*.sqlcipher
*.sqlite
*.sqlite3
*.db
backup-*/
private/
real-data/
evaluation-corpus/

# ---- Rust --------------------------------------------------------------------
# Cargo.lock IS committed: this is an application, and 07 requires pinned builds.
target/
**/*.rs.bk

# ---- Python ------------------------------------------------------------------
# uv.lock IS committed.
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.python-version
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ---- Node and the web UI -----------------------------------------------------
# The lockfile IS committed.
node_modules/
.vite/
.turbo/
*.tsbuildinfo

# ---- Build output ------------------------------------------------------------
dist/
build/
out/
*.app/
*.dmg
*.msi
*.AppImage
*.deb

