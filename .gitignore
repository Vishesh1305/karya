xcuserdata/
*.xcuserstate
DerivedData/
.swiftpm/

# ---- Android -----------------------------------------------------------------
.gradle/
android/build/
android/app/build/
android/.cxx/
captures/

# ---- Design reference --------------------------------------------------------
# fetch-fonts.sh downloads licensed OFL font binaries here. They are large and
# reproducible from the script, so they are not tracked. The OFL license texts
# the script also downloads ARE tracked.
design/reference/fonts/*.ttf
design/reference/fonts/*.otf
design/reference/fonts/*.part
!design/reference/fonts/OFL-*.txt
#
# Caution, not an ignore rule: running fetch-fonts.sh rewrites
# design/reference/html/fonts.css with the fonts embedded as base64, turning a
# small file into several megabytes. That file is tracked in its small online
# form. Do not commit the embedded version.

# ---- Logs, scratch, and editors ----------------------------------------------
*.log
logs/
tmp/
scratch/
.idea/
.vscode/
*.swp

